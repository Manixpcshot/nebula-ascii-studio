{
  "name": "nebula-ascii-studio",
  "version": "1.1.1",
  "description": "Offline cross-platform image-to-ASCII studio",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "android:init": "npm run tauri -- android init",
    "postandroid:init": "node scripts/prepare-android.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "lucide-static": "^1.72.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
